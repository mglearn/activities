{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mglearn.github.io/activities/eventmaps/data/schema/activity.schema.json",
  "title": "History Event Maps — Activity",
  "description": "One source of truth for an Event Map activity. Browser page, PDFs, and teacher guide are all generated from this record. TEKS codes reference data/standards/*.json and must never be fabricated.",
  "type": "object",
  "required": ["id", "title", "gradeBands", "courses", "mapType", "era", "estimatedMinutes", "challenge", "sources", "teks", "i18nKey"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "URL-safe slug, e.g. boston-tea-party" },
    "title": { "type": "string", "minLength": 2 },
    "i18nKey": { "type": "string", "description": "Namespace registered with BreakoutI18n for this activity's localized strings." },
    "gradeBands": { "type": "array", "minItems": 1, "items": { "enum": ["3-5", "6-8", "9-12"] } },
    "courses": { "type": "array", "minItems": 1, "items": { "enum": ["elementary-ss", "texas-history", "us-history", "world-history", "world-geography", "government", "economics"] } },
    "mapType": { "enum": ["history-trail", "cause-ripples", "people-place-change", "turning-point", "voices-around-event", "conflict-consequence", "evidence-dossier", "systems-shockwave", "continuity-change"] },
    "era": { "type": "string" },
    "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 120 },
    "summary": { "type": "string" },
    "challenge": { "type": "string", "minLength": 10, "description": "2-4 sentence investigation prompt; must not reveal the full answer." },
    "event": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "place": { "type": "string" }
      }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "Voices Around the Event: 3-5 stakeholder cards. Teacher fields carry suggested responses; student view leaves them blank.",
      "items": {
        "type": "object",
        "required": ["id", "nameKey"],
        "properties": {
          "id": { "type": "string" },
          "nameKey": { "type": "string" },
          "icon": { "type": "string" },
          "teacher": {
            "type": "object",
            "properties": {
              "wanted": { "type": "string" },
              "feared": { "type": "string" },
              "action": { "type": "string" },
              "evidence": { "type": "string" },
              "affected": { "type": "string" }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["n", "titleKey", "type", "url"],
        "properties": {
          "n": { "type": "integer", "minimum": 1, "maximum": 3 },
          "titleKey": { "type": "string" },
          "type": { "enum": ["primary", "secondary"] },
          "url": { "type": "string", "format": "uri" },
          "descKey": { "type": "string" },
          "questionKeys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "comparePromptKeys": { "type": "array", "items": { "type": "string" } },
    "conclusionKey": { "type": "string" },
    "ace": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "articulateKey": { "type": "string" },
        "connectKey": { "type": "string" },
        "extendKey": { "type": "string" }
      }
    },
    "teks": {
      "type": "object",
      "required": ["standardsFile", "content", "skills"],
      "properties": {
        "standardsFile": { "type": "string", "description": "Path to the verified standards JSON (e.g. standards/teks-grade8-us.json)." },
        "content": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\([A-Z]\\)$" } },
        "skills": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\([A-Z]\\)$" } }
      }
    },
    "teacher": {
      "type": "object",
      "properties": {
        "keyIdeasKey": { "type": "string" },
        "misconceptionsKey": { "type": "string" },
        "vocabularyKey": { "type": "string" },
        "contextKey": { "type": "string" },
        "extensionKey": { "type": "string" }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "translationStatus": {
      "type": "object",
      "description": "Per-language QA state. 'human' = reviewed by a fluent speaker; 'mt-pending-review' = machine-assisted, needs review before release.",
      "additionalProperties": { "enum": ["human", "mt-pending-review", "missing"] }
    }
  }
}
